{
  "$id": "search-log",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["date", "where", "result"],
    "additionalProperties": false,
    "properties": {
      "date": { "$ref": "defs#/definitions/date" },
      "persons": { "type": "array", "items": { "$ref": "defs#/definitions/id" } },
      "where": { "type": "string" },
      "query": { "type": "string" },
      "result": { "enum": ["found", "not_found", "partial"] },
      "summary": { "type": "string", "description": "Вывод одной фразой: что этот поиск значит для семьи" },
      "sources": { "type": "array", "items": { "$ref": "defs#/definitions/id" } },
      "next": { "type": "string" },
      "note": { "type": "string" }
    }
  }
}

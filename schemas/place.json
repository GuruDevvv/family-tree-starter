{
  "$id": "place",
  "type": "object",
  "required": ["id", "name_then"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "defs#/definitions/id" },
    "name_then": { "type": "string" },
    "kind": { "enum": ["village", "town", "city", "parish", "volost", "uyezd", "governorate", "other"] },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "governorate": { "type": "string" },
        "uyezd": { "type": "string" },
        "volost": { "type": "string" },
        "parish": { "type": "string" }
      }
    },
    "name_now": { "type": "string" },
    "coords": {
      "type": "object",
      "required": ["lat", "lon", "precision"],
      "additionalProperties": false,
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": { "enum": ["exact", "approx"] },
        "how": { "type": "string" }
      }
    },
    "url": { "type": "string", "pattern": "^https://" },
    "archive": { "$ref": "defs#/definitions/id" },
    "period": { "type": "string" },
    "note": { "type": "string" }
  }
}
